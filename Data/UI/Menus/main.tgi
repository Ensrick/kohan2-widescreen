[MainMenuLabelVersion Template=LabelWidget]
{
	[View Template = NoVE]
	L = 5
	T = 40b
	
	[Label Template=LabelVE]
	multiline = true
	text = "#main_Label_text"
	font = small
	justify = LEFT
}

