/**************************************************************************

font_tiny.tgi - modern-Windows compatibility override

CJK character sets removed; see font_large.tgi header for the rationale.

**************************************************************************/

[Font template = Font]
{
	ids = tiny
	name = "#font_tiny_name"
	size = 11

	[CharacterSet]
	{
		ids = base
		;; was Arial - see font_small.tgi for why system Arial is avoided
		font = /fonts/truetype/LBRITED.TTF
		bold = true
		shadow = true
		shadow_opacity = .4
		shadow_brightness = 0

	}
}

[Font template = Font]
{
	ids = tiny_outline
	name = "#font_tiny_name"
	size = 16

	[CharacterSet]
	{
		ids = base
		;; was Arial - see font_small.tgi for why system Arial is avoided
		font = /fonts/truetype/LBRITED.TTF
		antialias = false
		bold = true
		outline = true
		shadow_opacity = .4
		shadow_brightness = 0
	}
}
